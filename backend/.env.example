# App
ENVIRONMENT=production
APP_VERSION=1.0.0
CORS_ALLOW_ORIGINS=http://localhost:3000
AUTH_REQUIRED=true
DEV_USER_ID=

# Observability
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# Database
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB_NAME
DB_SSL_VERIFY=true
SQL_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Storage (Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Queue (Redis/Upstash)
REDIS_URL=
UPSTASH_REDIS_URL=
REDIS_SSL_CERT_REQS=required
CELERY_TIMEZONE=UTC

# AI Model
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Pipeline flags
AUTO_APPLY_ENABLED=true
AUTO_APPLY_DRY_RUN=false
RUN_E2E_TESTS=false

# Digest integrations (optional)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=digest@example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
